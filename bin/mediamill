#!/usr/bin/env zsh
# Host wrapper: runs ghcr.io/gidw/mediamill via podman with the right mounts. Put this file on
# your PATH (symlink it into ~/.local/bin, or add this directory); it runs under zsh whatever
# shell you call it from.
# Usage identical to the tool: mediamill [--jobs N] [--force] [--quiet] [--extract-only] <input> [output]
# macOS: paths must live under /Users, /private or /var/folders (podman machine shares only those).
set -u
image="${MEDIAMILL_IMAGE:-ghcr.io/gidw/mediamill:latest}"
typeset -a opts mounts run
while (( $# )) && [[ "$1" == --* ]]; do
  opts+=("$1"); [[ "$1" == --jobs && $# -ge 2 ]] && { opts+=("$2"); shift }; shift
done
(( ${opts[(I)--help]} )) && exec podman run --rm "$image" --help
(( $# >= 1 && $# <= 2 )) || { print -u2 "usage: mediamill [--jobs N] [--force] [--quiet] [--extract-only] <input> [output]"; exit 1 }
input="$1" output="${2:-}"
[[ -e "$input" ]] || { print -u2 -r -- "mediamill: no such input: $input"; exit 1 }
in_abs="${input:A}"
if [[ -d "$in_abs" ]]; then
  [[ -n "$output" ]] || { print -u2 "mediamill: output directory required"; exit 1 }
  out_abs="${output:A}"
  [[ "$out_abs" == "$in_abs" || "$out_abs" == "$in_abs"/* ]] && { print -u2 "mediamill: output must not be the input or inside it"; exit 1 }
  mkdir -p -- "$output" || exit 1
  mounts=(-v "${in_abs}:/in:ro" -v "${out_abs}:/out"); ctr_in=/in; ctr_out=/out
else
  mounts=(-v "${in_abs:h}:/in:ro"); ctr_in="/in/${in_abs:t}"
  if [[ -n "$output" ]]; then
    mkdir -p -- "${output:A:h}" || exit 1
    mounts+=(-v "${output:A:h}:/out"); ctr_out="/out/${output:t}"
  else
    mounts+=(-v "${PWD:A}:/out"); ctr_out=""
  fi
fi
run=(podman run --rm --init --userns=keep-id:uid=65532,gid=65532 -w /out)
[[ "$OSTYPE" == linux* ]] && run+=(--group-add keep-groups)
[[ -t 0 && -t 1 ]] && run+=(-it)
[[ -n "${MM_JOBS:-}" ]] && run+=(-e MM_JOBS)
# exec: podman replaces this script, so Ctrl-C and the exit code go straight to and from it.
exec "${run[@]}" "${mounts[@]}" "$image" "${opts[@]}" "$ctr_in" ${ctr_out:+"$ctr_out"}
