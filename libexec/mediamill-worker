#!/usr/bin/env zsh
# Convert ONE file. Invoked by libexec/mediamill (directly or via xargs -P).
# Usage: mediamill-worker <absolute-file>
# Env (all optional except the roots in directory mode): see README "worker interface".
set -u
readonly file="$1"
# Trailing slashes are stripped so "${file#${in_root}/}" maps in -> out correctly with MM_IN_ROOT=/in/.
readonly in_root="${${MM_IN_ROOT:?MM_IN_ROOT not set}%/}"
readonly out_root="${${MM_OUT_ROOT:?MM_OUT_ROOT not set}%/}"
readonly vips_opts="${MM_VIPS_OPTS:-[Q=75,keep=none,trellis-quant,interlace,optimize-coding,optimize-scans,quant-table=3,subsample_mode=on]}"
readonly vips_bin="${MM_VIPS:-vips}"
readonly ffmpeg_bin="${MM_FFMPEG:-ffmpeg}"
readonly force="${MM_FORCE:-0}"
source "${0:A:h}/mediamill-lib.zsh" || exit 1

readonly rel="${file#${in_root}/}"
readonly dest="${out_root}/${rel}"
readonly ext_lower="${${file:e}:l}"

fail() { print -u2 -r -- "FAIL ${rel}: $1"; exit 1 }

# Write through a temp name that keeps the extension (vips and ffmpeg pick the
# format from it), then rename: a killed run never leaves a truncated target.
# tmp/errf are globals so the signal trap can remove them. A signal to this shell
# alone does not reach the vips/ffmpeg child: zsh runs the trap after the foreground
# child exits, so cleanup happens once the (complete) temp file exists. A group signal
# (Ctrl-C, or the dispatcher's kill 0) stops the child immediately and cleanup runs then.
tmp=""; errf=""
cleanup() { [[ -n "$tmp" ]] && rm -f -- "$tmp"; [[ -n "$errf" ]] && rm -f -- "$errf"; }
trap 'cleanup; exit 130' INT TERM HUP

# make-like freshness: an existing target newer than its source is done unless --force.
# Re-runs over a large tree therefore only touch new or changed sources, and an
# interrupted run resumes (temp+rename guarantees an existing target is complete).
up_to_date() { [[ "$force" != 1 && -e "$1" && "$1" -nt "$file" ]] }

convert_to() {
  local kind="$1" target="$2"
  if up_to_date "$target"; then
    print -r -- "SKIP ${rel}"; return 0
  fi
  tmp="${target:r}.mmtmp$$.${target:e}"
  errf="$(mktemp "${TMPDIR:-/tmp}/mm.XXXXXX")"
  local rc=0
  case "$kind" in
    # thumbnail, not copy: it applies EXIF orientation to the pixels and converts an embedded
    # ICC profile (Display P3 from iPhones, CMYK) to sRGB; keep=none then drops all metadata.
    # The bound is VIPS_MAX_COORD with --size down, so nothing is ever resized. Untagged,
    # upright sources come out byte-identical to a plain copy.
    image) "$vips_bin" thumbnail "$file" "${tmp}${vips_opts}" 10000000 --size down --export-profile srgb \
             2>"$errf" || rc=$? ;;
    video) "$ffmpeg_bin" -nostdin -hide_banner -loglevel error -y -i "$file" \
             -movflags faststart -pix_fmt yuv420p \
             -vf 'scale=trunc(iw/2)*2:trunc(ih/2)*2' -crf 24 -preset slow \
             "$tmp" 2>"$errf" || rc=$? ;;
  esac
  if (( rc != 0 )); then
    local reason; reason="$(head -c 300 "$errf" | tr '\n' ' ')"
    cleanup
    fail "exit ${rc} ${reason}"
  fi
  mv -f -- "$tmp" "$target" || { cleanup; fail "rename failed" }
  tmp=""; cleanup
  case "$kind" in image) print -r -- "JPG ${rel}" ;; video) print -r -- "MP4 ${rel}" ;; esac
}

# One source, one target: two sources mapping to the same name are rejected up front
# by libexec/mediamill (clash preflight), so no renaming happens here.
mm_kind "$ext_lower"; readonly kind="$REPLY"
mm_target "$dest"
case "$kind" in
  image|video) convert_to "$kind" "$REPLY" ;;
  other)
    if up_to_date "$dest"; then print -r -- "SKIP ${rel}"; exit 0; fi
    cp -- "$file" "$dest" || fail "copy failed"
    print -r -- "CP ${rel}" ;;
esac
